# Base URL of your RESTful API backend.
# Ganti dengan URL API kamu sendiri, contoh: https://api.mydomain.com/api
# Untuk demo, project ini pakai JSONPlaceholder (data tidak benar-benar tersimpan).
NEXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com

# Endpoint login (jika API kamu punya auth sendiri, sesuaikan path-nya di services/authService.ts)
NEXT_PUBLIC_AUTH_ENDPOINT=/auth/login
